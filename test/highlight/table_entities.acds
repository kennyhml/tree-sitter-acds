@EndUserText.label: 'Flight table'
define root table entity /DMO/flight
// <- keyword
//                       ^ type
{
  key id : abap.int4;
//^ keyword.modifier
//    ^ variable.member
//         ^ module
//              ^ type.builtin

  amount : abap.dec(15, 2) null;
//^ variable.member
//                  ^ number
  currency : CurrencyCode;
//^ variable.member
//           ^ type

  _carrier : association of exact one to many /DMO/carrier
//^ variable.member
//                                            ^ type
    on _carrier.id = /DMO/flight.id
//     ^ variable.member
//              ^ variable.member
//                   ^ type
//                               ^ variable.member
    and _carrier.currency = $projection.currency
//      ^ variable.member
//               ^ variable.member
//                          ^ constant.builtin
//                                      ^ variable.member
    with default filter
      active = 'X'
//    ^ variable.member
//             ^ string
      and amount >= 100
//        ^ variable.member
//                  ^ operator
//                   ^ number
      and language = $session.system_language;
//                   ^ constant.builtin
//                            ^ variable.member

  _items : composition of exact one to many /DMO/flight_item;
//^ variable.member
//                                          ^ type
}

define table entity /DMO/flight_item
//                  ^ type
{
  key id : abap.int4;

  _parent : association to parent /DMO/flight
//^ variable.member
//                                ^ type
    on _parent.id = $projection.id;
//     ^ variable.member
//             ^ variable.member
//                  ^ constant.builtin
//                              ^ variable.member
}
